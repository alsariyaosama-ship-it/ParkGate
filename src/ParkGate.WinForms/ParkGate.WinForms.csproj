<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\Icons\app.ico</ApplicationIcon>
    <AssemblyTitle>بوابة منتزه المرح العائلي</AssemblyTitle>
    <Product>بوابة منتزه المرح العائلي</Product>
    <Description>منظومة بوابة منتزه المرح العائلي للتحكم في بوابات الدخول</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ParkGate.Domain\ParkGate.Domain.csproj" />
    <ProjectReference Include="..\ParkGate.Application\ParkGate.Application.csproj" />
    <ProjectReference Include="..\ParkGate.Infrastructure\ParkGate.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Resources\Fonts\Cairo.ttf" />
    <None Update="Resources\Fonts\Cairo.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Resources\Icons\app.ico" />
    <EmbeddedResource Include="Resources\Icons\app.png" />
    <None Update="Resources\Icons\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Icons\app.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>