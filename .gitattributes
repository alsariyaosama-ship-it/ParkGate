# Normalize line endings; Windows-native files keep CRLF on checkout
* text=auto

*.cs      text eol=crlf diff=csharp
*.csproj  text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf
*.sln     text eol=crlf
*.slnx    text eol=crlf
*.resx    text eol=crlf
*.config  text eol=crlf
*.json    text eol=crlf
*.ps1     text eol=crlf
*.iss     text eol=crlf
*.sql     text eol=crlf

*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf

*.png  binary
*.jpg  binary
*.ico  binary
*.wav  binary
*.ttf  binary
*.dll  binary
*.exe  binary
