APP_NAME=ParkGate
APP_ENV=production
APP_KEY=base64:eKgeknsmZ5HGmvf6hfXvNJmvxgBXb+bnz2j0tGfhVxc=
APP_DEBUG=false
APP_URL=https://your-domain.ly

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

LOG_CHANNEL=daily
LOG_LEVEL=error

# إعدادات قاعدة بيانات MySQL على cPanel (العنكبوت الليبي)
# ملاحظة هامة: يجب وضع كلمة المرور بين علامتي تنصيص مفردة ' ' لتجنب مشاكل الرموز الخاصة
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_parkgate
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD='YOUR_STRONG_PASSWORD_HERE'

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# مفاتيح مزامنة ووركر الديسكتوب
PARKGATE_API_KEY=parkgate-cloud-secret-key-2026
PARKGATE_AES_KEY=YOUR_AES_256_BASE64_KEY
